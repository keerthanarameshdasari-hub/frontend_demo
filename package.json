{
  "name": "frontend_demo",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile wallet app for the demo: sign in, KYC upload, wallet balance and top-up. React Native, TypeScript.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "react-native start",
    "android:dev": "react-native run-android --mode devDebug --appIdSuffix dev",
    "android:test": "react-native run-android --mode tstDebug --appIdSuffix test",
    "android:uat": "react-native run-android --mode uatDebug --appIdSuffix uat",
    "android:prod": "react-native run-android --mode prodDebug",
    "ios:dev": "react-native run-ios --scheme Dev --mode Debug-Dev",
    "ios:test": "react-native run-ios --scheme Test --mode Debug-Test",
    "ios:uat": "react-native run-ios --scheme Uat --mode Debug-Uat",
    "ios:prod": "react-native run-ios --scheme Prod --mode Debug-Prod",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:contract": "jest __tests__/contract.test.ts",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript api/openapi.json --output src/api/schema.d.ts && prettier --loglevel warn --write src/api/schema.d.ts",
    "api:check": "node scripts/fetch-openapi.mjs --check && npm run api:generate && git diff --exit-code -- src/api/schema.d.ts",
    "config:check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@react-native-documents/picker": "12.0.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-config": "1.7.2",
    "react-native-device-info": "15.0.2",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "openapi-typescript": "7.13.0",
    "prettier": "2.8.8",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
