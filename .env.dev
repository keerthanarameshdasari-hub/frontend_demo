# Public, non-secret build config for the dev environment. Never put secrets here:
# everything in this file is compiled into the app and readable by anyone who has it.
ENV_NAME=dev
# backend_demo running locally via `docker compose up` on the developer's machine.
API_URL=http://localhost:3000
# The Android emulator reaches the host machine at 10.0.2.2, not localhost.
API_URL_ANDROID=http://10.0.2.2:3000
